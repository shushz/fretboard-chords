{
  "name": "fretboard-chords",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first PWA for learning diatonic chord shapes, chord tones and chord relationships on the guitar neck.",
  "license": "MIT",
  "author": "Alexander Dvinsky",
  "homepage": "https://shushz.github.io/fretboard-chords/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shushz/fretboard-chords.git"
  },
  "keywords": [
    "guitar",
    "chords",
    "fretboard",
    "music-theory",
    "pwa",
    "practice"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off --grep-invert walkthrough",
    "screenshots": "SCREENSHOTS=1 playwright test --trace off --grep-invert walkthrough",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "audit": "playwright test --trace off tests/e2e/audit.spec.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "idb-keyval": "^6.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
